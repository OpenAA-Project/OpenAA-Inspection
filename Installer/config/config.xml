<?xml version="1.0" encoding="UTF-8"?>
<Installer>
    <Name>OpenAA</Name>
    <Version>6.1.0</Version>
    <Title>OpenAA inspection software</Title>
    <Publisher>MEGATRADE Corporation</Publisher>
    <WizardStyle>Modern</WizardStyle>
    <Logo>logo.png</Logo>
    <Banner>banner.png</Banner>

    <InstallerApplicationIcon>installer_OpenAAIcon</InstallerApplicationIcon>

    <StartMenuDir>OpenAA</StartMenuDir>
    <TargetDir>@RootDir@OpenAA</TargetDir>
    <RemoveTargetDir>false</RemoveTargetDir>
    <AllowNonAsciiCharacters>true</AllowNonAsciiCharacters>
    <AllowSpaceInPath>true</AllowSpaceInPath>

    <ControlScript>controlscript.qs</ControlScript>
</Installer>